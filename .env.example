# === 必填 ===
SG_ADMIN_TOKEN=change-me-to-a-long-random-token

# === 常用 ===
SG_PUBLIC_READ=true            # false 时读 API 也要 token，且必须设 SG_SIGN_SECRET
SG_SIGN_SECRET=
SG_BLOB_DRIVER=local           # local | s3

# === s3 模式 ===
SG_S3_ENDPOINT=http://minio:9000
SG_S3_BUCKET=shiguang
SG_S3_REGION=us-east-1
SG_S3_AK=minioadmin
SG_S3_SK=minioadmin
SG_S3_PATH_STYLE=true
SG_S3_CDN_BASE=

# === 限额 / 运维 ===
SG_LIMIT_UPLOAD_MB=30
SG_LIMIT_PIXELS_MP=60
SG_TRASH_TTL_DAYS=7
SG_WORKERS=0                   # 0 = NumCPU

# === litestream 备份目标（S3 兼容） ===
BACKUP_S3_AK=
BACKUP_S3_SK=

# === MinIO（--profile s3 时） ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
